# JazzCash hosted checkout (optional). Sandbox: https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_ENV="sandbox"

# Stripe cards (optional). Restricted key preferred. Webhook: /api/payments/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional EasyPaisa gateway (not required for wallet P2P matching)
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# mock = DEVELOPMENT ONLY. Never enable in production.
PAYMENTS_MODE=""


DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# TTN collection accounts — also editable in /admin. Agencies pay the 2.5% fee here.
TTN_JAZZCASH_NAME="TTN Travel To North"
TTN_JAZZCASH_NUMBER="03XXXXXXXXX"
TTN_EASYPAISA_NAME="TTN Travel To North"
TTN_EASYPAISA_NUMBER="03XXXXXXXXX"
TTN_BANK_NAME="Meezan Bank"
TTN_BANK_TITLE="TTN Travel To North"
TTN_BANK_IBAN="PK00MEZN0000000000000000"

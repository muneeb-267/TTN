DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
APP_URL="http://localhost:3000"

# Operator login created by `npm run db:prod` (never commit real values)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="TTN Admin"
# ADMIN_PASSWORD_RESET="1"

# Public support address shown in the footer (optional)
# SUPPORT_EMAIL="complaints@ttn.pk"

# TTN collection accounts — also editable in /admin/settings.
# Leave blank until you have the live IBAN / wallets. Placeholder zeros are rejected.
TTN_BANK_NAME=""
TTN_BANK_TITLE=""
TTN_BANK_IBAN=""
TTN_BANK_ACCOUNT=""
TTN_JAZZCASH_NAME=""
TTN_JAZZCASH_NUMBER=""
TTN_EASYPAISA_NAME=""
TTN_EASYPAISA_NUMBER=""

# JazzCash hosted checkout (optional). Sandbox: https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
JAZZCASH_ENV="sandbox"

# Stripe cards (optional). Restricted key (rk_) preferred. Webhook: /api/payments/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional EasyPaisa gateway (not required for wallet P2P matching)
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# mock = DEVELOPMENT ONLY. Never enable in production.
PAYMENTS_MODE=""

# Local/Cursor `next start` only. Do not set on the public domain.
# TTN_ALLOW_PREVIEW="1"

# Review demo logins on /traveler/login, /agency/login, /admin/login.
# Hidden automatically on a real https domain. Force on/off with 1 or 0.
# SHOW_DEMO_ACCOUNTS=""

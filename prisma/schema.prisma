generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  name         String
  passwordHash String
  role         String
  locale       String    @default("en")
  createdAt    DateTime  @default(now())
  suspendedAt  DateTime?

  agency           Agency?
  bookings         Booking[]
  comments         Comment[]
  reviews          TripReview[]
  refundRequests   RefundRequest[] @relation("TravelerRefunds")
  notifications    Notification[]
  savedTrips       SavedTrip[]
  disputes         Dispute[]
  auditLogs        AuditLog[]
}

model Agency {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName          String
  city                  String
  about                 String
  status                String   @default("PENDING")
  realMediaDeclaration  Boolean  @default(false)
  createdAt             DateTime @default(now())
  clientPhones          String   @default("[]")
  jazzcashName          String   @default("")
  jazzcashNumber        String   @default("")
  easypaisaName         String   @default("")
  easypaisaNumber       String   @default("")
  bankName              String   @default("")
  bankTitle             String   @default("")
  bankIban              String   @default("")
  bankAccount           String   @default("")
  delistedAt            DateTime?

  signupReviews AgencySignupReview[]
  media         Media[]
  trips         Trip[]
  reviews       TripReview[]
  refunds       RefundRequest[]
  feePayments   PlatformFeePayment[]
  ledger        LedgerEntry[]
  settlements   Settlement[]
  disputes      Dispute[]
}

model PlatformSettings {
  id              String @id @default("ttn")
  jazzcashName    String @default("")
  jazzcashNumber  String @default("")
  easypaisaName   String @default("")
  easypaisaNumber String @default("")
  bankName        String @default("")
  bankTitle       String @default("")
  bankIban        String @default("")
  bankAccount     String @default("")
  commissionBps        Int     @default(250)
  processingFeeBps     Int     @default(0)
  depositBps           Int     @default(5000)
  seatHoldMinutes      Int     @default(10)
  remainingDueDays     Int     @default(1)
  minDaysForDeposit    Int     @default(6)
  currency             String  @default("PKR")
  timezone             String  @default("Asia/Karachi")
  minTripPrice         Int     @default(1000)
  maxBookingSeats      Int     @default(20)
  requireTripApproval  Boolean @default(false)
  cancelPolicyJson     String  @default("")
}

model PlatformFeePayment {
  id               String    @id @default(cuid())
  agencyId         String
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  amount           Int
  method           String
  status           String    @default("PENDING")
  providerTxn      String    @default("")
  payerAccount     String    @default("")
  receiptUrl       String    @default("")
  source           String    @default("AGENCY")
  bookingPaymentId String?   @unique
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
}

model AgencySignupReview {
  id              String @id @default(cuid())
  agencyId        String
  agency          Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientName      String
  rating          Int
  comment         String
  tripDestination String
}

model Media {
  id             String  @id @default(cuid())
  agencyId       String
  agency         Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tripId         String?
  trip           Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)
  reviewId       String?
  review         TripReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  kind           String
  url            String
  caption        String  @default("")
  isPreviousTrip Boolean @default(false)
}

model Trip {
  id             String   @id @default(cuid())
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title          String
  fromCity       String
  toDestination  String
  departureAt    DateTime
  returnAt       DateTime
  vehicleType    String
  vehicleDetail  String
  seatCount      Int
  pricePerSeat   Int
  itinerary      String
  hotelLinks     String
  mealsIncluded    Boolean  @default(false)
  familyFriendly   Boolean  @default(false)
  tripStyle        String   @default("")
  meetingPoint     String   @default("")
  includedJson     String   @default("[]")
  excludedJson     String   @default("[]")
  importantInfo    String   @default("")
  cancelPolicyJson String   @default("")
  depositBps       Int?
  published        Boolean  @default(true)
  approvalStatus   String   @default("PUBLISHED")
  createdAt        DateTime @default(now())
  jazzcashName     String @default("")
  jazzcashNumber   String @default("")
  easypaisaName    String @default("")
  easypaisaNumber  String @default("")
  bankName         String @default("")
  bankTitle        String @default("")
  bankIban         String @default("")
  bankAccount      String @default("")

  seats      Seat[]
  bookings   Booking[]
  comments   Comment[]
  media      Media[]
  reviews    TripReview[]
  savedBy    SavedTrip[]
  disputes   Dispute[]

  @@index([fromCity, toDestination, departureAt])
  @@index([published, departureAt])
}

model Seat {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  code      String
  row       Int
  col       Int
  aisleAfter Boolean @default(false)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([tripId, code])
}

model Booking {
  id              String    @id @default(cuid())
  publicRef       String    @unique
  travelerId      String
  traveler        User      @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status          String
  totalPrice      Int
  depositAmount   Int
  remainingAmount Int
  platformFee     Int
  processingFee   Int       @default(0)
  agencySettlement Int      @default(0)
  refundAmount    Int       @default(0)
  netRevenue      Int       @default(0)
  commissionBps   Int       @default(250)
  processingFeeBps Int      @default(0)
  paymentMethod   String
  bookedAt        DateTime  @default(now())
  remainingDueAt  DateTime
  depositPaidAt   DateTime?
  remainingPaidAt DateTime?
  completedAt     DateTime?
  holdUntil       DateTime?

  seats      Seat[]
  payments   Payment[]
  refund     RefundRequest?
  review     TripReview?
  ledger     LedgerEntry[]
  disputes   Dispute[]

  @@index([status, bookedAt])
  @@index([travelerId, status])
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind          String
  amount        Int
  method        String
  status        String    @default("PENDING")
  providerRef   String    @default("")
  payerAccount  String    @default("")
  receiptUrl    String    @default("")
  providerTxn           String    @default("")
  collectedByPlatform   Boolean   @default(false)
  confirmedAt           DateTime?
  respondedAt           DateTime?
  failureReason         String    @default("")
  idempotencyKey        String    @default("")
  createdAt             DateTime  @default(now())

  @@index([status, createdAt])
  @@index([providerTxn])
}

model RefundRequest {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId     String
  traveler       User     @relation("TravelerRefunds", fields: [travelerId], references: [id], onDelete: Cascade)
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reason         String
  status         String   @default("PENDING")
  sameDay        Boolean
  travelerRefund Int
  platformKeep   Int
  agencyKeep     Int
  agencyNote     String   @default("")
  createdAt      DateTime @default(now())
  decidedAt      DateTime?
  agencyFine     Int      @default(0)
  payoutMethod      String @default("")
  payoutAccountName String @default("")
  payoutAccountNo   String @default("")
  payoutBank        String @default("")
}

model Comment {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model TripReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  travelerId String
  traveler   User     @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  rating     Int
  body       String
  createdAt  DateTime @default(now())
  photos     Media[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @unique
  title     String
  body      String
  href      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BookingSequence {
  year    Int @id
  lastSeq Int @default(0)
}

model LedgerEntry {
  id         String   @id @default(cuid())
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  agencyId   String?
  agency     Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type       String
  amount     Int
  currency   String   @default("PKR")
  reference  String
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([agencyId, type])
  @@index([bookingId, type])
  @@unique([reference, type])
}

model Settlement {
  id              String    @id @default(cuid())
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  grossAmount     Int
  commissionAmount Int
  processingFeeAmount Int
  refundAmount    Int
  netPayable      Int
  status          String    @default("PENDING")
  note            String    @default("")
  periodStart     DateTime
  periodEnd       DateTime
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  paidAt          DateTime?

  @@index([agencyId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  oldValue  String   @default("")
  newValue  String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Dispute {
  id          String   @id @default(cuid())
  reporterId  String
  reporter    User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  agencyId    String?
  agency      Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  kind        String
  body        String
  status      String   @default("OPEN")
  resolution  String   @default("")
  createdAt   DateTime @default(now())
  decidedAt   DateTime?

  @@index([status, createdAt])
}

model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tripId])
}
